# Rename this file to .env and fill in your real values

# Port for the backend server
PORT=5000

# SMTP settings (example uses Gmail — use an "App Password", not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-college-email@gmail.com
SMTP_PASS=your-app-password

# Who "from" address should show as (usually same as SMTP_USER)
MAIL_FROM="NEC Grievance Portal <your-college-email@gmail.com>"

# Admin email(s) that receive a copy of every grievance. Comma-separate for multiple.
ADMIN_EMAIL=principal@nec.edu.in

# Admin login credentials for the Admin Dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Allowed origin(s) for CORS (comma-separated or single)
# Local Vite runs on http://localhost:5173, and production runs on your Vercel domain
CLIENT_ORIGIN=http://localhost:5173,https://grievanceportalfrontend-frontendgri.vercel.app
FRONTEND_URL=https://grievanceportalfrontend-frontendgri.vercel.app
